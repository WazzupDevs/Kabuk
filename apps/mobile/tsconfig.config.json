{
  // app.config.ts runs in Node at build time; kept apart so Node types do not leak into the app.
  // The 2 Kasım acceptance test (K1–K17) reads the kit, which imports React Native's types: they
  // clash with the root tests' fetch, so it is checked here.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "module": "preserve",
    "moduleResolution": "bundler"
  },
  "include": ["app.config.ts", "src/theme/kabul.test.ts"]
}
