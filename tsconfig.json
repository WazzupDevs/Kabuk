{
  // Root-level files not covered by a workspace package: tooling config and pure/ tests.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": [
    "vitest.config.ts",
    "vitest.integration.config.ts",
    "supabase/functions/_shared/pure/**/*.test.ts",
    "apps/mobile/src/theme/**/*.test.ts",
    "apps/mobile/src/i18n/words.test.ts",
    "supabase/tests/**/*.ts"
  ],
  // Checked by apps/mobile/tsconfig.config.json (its kit import brings React Native's types).
  "exclude": [
    "apps/mobile/src/theme/kabul.test.ts",
    "apps/mobile/src/theme/kinshiDeck.test.ts",
    "apps/mobile/src/theme/krot.test.ts"
  ]
}
