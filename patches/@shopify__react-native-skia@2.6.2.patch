@@ -3,6 +3,7 @@
 #if __ANDROID_API__ >= 26
 #include <android/hardware_buffer.h>
 #endif
+#include <chrono>
 #include <exception>
 #include <functional>
 #include <memory>
@@ -178,6 +179,22 @@ public:
   }
 
 #if !defined(SK_GRAPHITE)
+  void purgeGpuResources(double limitBytes, double msNotUsed) override {
+    runOnMainThread([limitBytes, msNotUsed]() {
+      auto &gl = OpenGLContext::getInstance();
+      gl.makeCurrent();
+      auto context = gl.getDirectContext();
+      if (context == nullptr) {
+        return;
+      }
+      if (limitBytes > 0) {
+        context->setResourceCacheLimit(static_cast<size_t>(limitBytes));
+      }
+      context->performDeferredCleanup(
+          std::chrono::milliseconds(static_cast<int64_t>(msNotUsed)));
+    });
+  }
+
   GrDirectContext *getDirectContext() override {
     return OpenGLContext::getInstance().getDirectContext();
   }
