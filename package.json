{
  "name": "masa",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck && pnpm typecheck:shared && pnpm typecheck:functions && tsc -p tsconfig.json",
    "typecheck:shared": "tsc -p supabase/functions/_shared/pure/tsconfig.json",
    "lint": "eslint . --max-warnings 0 && pnpm lint:functions",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "pnpm --filter scripts build-seed",
    "icons": "pnpm --filter scripts build-icons",
    "tokens": "pnpm --filter scripts build-tokens",
    "site:build": "pnpm --filter scripts build-site",
    "store:screenshots": "pnpm --filter scripts store-screenshots",
    "gen:types": "supabase gen types typescript --local > supabase/functions/_shared/pure/database.ts && prettier --write supabase/functions/_shared/pure/database.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck:functions": "deno check --node-modules-dir=none supabase/functions/*/index.ts",
    "lint:functions": "deno lint supabase/functions",
    "admin:ban": "pnpm --filter scripts admin:ban",
    "admin:delete": "pnpm --filter scripts admin:delete",
    "admin:event": "pnpm --filter scripts admin:event",
    "admin:remove-photo": "pnpm --filter scripts admin:remove-photo",
    "admin:move-photos": "pnpm --filter scripts admin:move-photos",
    "admin:set-birth-date": "pnpm --filter scripts admin:set-birth-date",
    "admin:set-gender": "pnpm --filter scripts admin:set-gender",
    "db:reset": "supabase db reset && pnpm --filter scripts apply-local-secrets",
    "fetch:venues": "pnpm --filter scripts fetch:venues",
    "latency": "pnpm --filter scripts latency",
    "functions:deploy": "pnpm --filter scripts functions:deploy",
    "visual:accept": "pnpm --filter scripts visual:accept"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "supabase"
    ],
    "peerDependencyRules": {
      "ignoreMissing": [
        "react-dom"
      ]
    },
    "patchedDependencies": {
      "react-native-svg@15.15.4": "patches/react-native-svg@15.15.4.patch"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@fontsource/bangers": "5.1.0",
    "@supabase/supabase-js": "^2.117.1",
    "@types/node": "^22.20.4",
    "deno": "^2.9.6",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "globals": "^16.5.0",
    "opentype.js": "1.3.4",
    "postgres": "^3.4.9",
    "prettier": "^3.9.9",
    "supabase": "^2.117.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "workspaces": [
    "apps/*",
    "scripts"
  ]
}
